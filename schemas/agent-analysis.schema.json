{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent-analysis.schema.json",
  "title": "Quality Report Agent Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_sha256",
    "intent",
    "facts",
    "actions",
    "limitations",
    "answer",
    "citations",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent": {
      "type": "string",
      "enum": [
        "summary",
        "priority",
        "not_assessable",
        "question"
      ]
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/limitation"
      }
    },
    "answer": {
      "$ref": "#/$defs/answer"
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "audit": {
      "$ref": "#/$defs/audit"
    }
  },
  "$defs": {
    "citationIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "citation_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact-[1-9][0-9]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citation_ids": {
          "$ref": "#/$defs/citationIds"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "title",
        "detail",
        "citation_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^action-[1-9][0-9]*$"
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citation_ids": {
          "$ref": "#/$defs/citationIds"
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "citation_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^limitation-[1-9][0-9]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citation_ids": {
          "$ref": "#/$defs/citationIds"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "citation_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "citation_ids": {
          "$ref": "#/$defs/citationIds"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "source_id",
        "label",
        "excerpt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_type": {
          "type": "string",
          "enum": [
            "summary",
            "risk",
            "metric",
            "not_assessable"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "mode",
        "prompt_version",
        "fallback_used",
        "fallback_reason",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "cache_hit"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "mode": {
          "type": "string",
          "enum": [
            "template",
            "model"
          ]
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fallback_used": {
          "type": "boolean"
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "tool_calls": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "get_report_summary",
              "list_priority_risks",
              "get_risk_evidence",
              "get_metric_evidence",
              "list_not_assessable"
            ]
          }
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cache_hit": {
          "type": "boolean"
        }
      }
    }
  }
}
