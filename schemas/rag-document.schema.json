{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/rag-document.schema.json",
  "title": "Quality Demo v0.9 RAG Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "title",
    "standard_number",
    "version",
    "published_at",
    "effective_status",
    "parser_version",
    "source_namespace",
    "source_name",
    "source_path",
    "content_sha256",
    "ingested_at",
    "approved",
    "chunk_ids",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "0.9"},
    "document_id": {"type": "string", "pattern": "^doc-[a-f0-9]{20}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "standard_number": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"]},
    "effective_status": {
      "enum": ["active", "draft", "superseded", "expired", "unknown"]
    },
    "parser_version": {"const": "quality-rag-parser-v0.9"},
    "source_namespace": {
      "enum": ["standards", "data_dictionary", "user_specification"]
    },
    "source_name": {"type": "string", "minLength": 1, "maxLength": 300},
    "source_path": {"type": ["string", "null"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ingested_at": {"type": "string", "minLength": 1},
    "approved": {"type": "boolean"},
    "chunk_ids": {
      "type": "array",
      "maxItems": 5000,
      "items": {"type": "string", "pattern": "^chunk-[a-f0-9]{20}$"}
    },
    "metadata": {"type": "object"}
  }
}
