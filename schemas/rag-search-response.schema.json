{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/rag-search-response.schema.json",
  "title": "Quality Demo v0.9 RAG Search Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "status",
    "results",
    "conflict",
    "filtered_document_count",
    "total_candidate_count",
    "namespace",
    "metric_id",
    "standard_number",
    "version"
  ],
  "properties": {
    "query": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "no_results", "conflict"]},
    "results": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "document_id",
          "document_name",
          "document_version",
          "standard_number",
          "source_namespace",
          "section",
          "clause",
          "page",
          "line_start",
          "line_end",
          "score",
          "matched_terms",
          "citation",
          "text"
        ],
        "properties": {
          "chunk_id": {"type": "string", "pattern": "^chunk-[a-f0-9]{20}$"},
          "document_id": {"type": "string", "pattern": "^doc-[a-f0-9]{20}$"},
          "document_name": {"type": "string", "minLength": 1},
          "document_version": {"type": ["string", "null"]},
          "standard_number": {"type": ["string", "null"]},
          "source_namespace": {
            "enum": ["standards", "data_dictionary", "user_specification"]
          },
          "section": {"type": ["string", "null"]},
          "clause": {"type": ["string", "null"]},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "line_start": {"type": ["integer", "null"], "minimum": 1},
          "line_end": {"type": ["integer", "null"], "minimum": 1},
          "score": {"type": "number", "minimum": 0},
          "matched_terms": {"type": "array", "items": {"type": "string"}},
          "citation": {"$ref": "#/$defs/citation"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "conflict": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "document_ids",
            "document_labels",
            "versions",
            "standard_numbers"
          ],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "document_ids": {"type": "array", "items": {"type": "string"}},
            "document_labels": {"type": "array", "items": {"type": "string"}},
            "versions": {"type": "array", "items": {"type": "string"}},
            "standard_numbers": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "filtered_document_count": {"type": "integer", "minimum": 0},
    "total_candidate_count": {"type": "integer", "minimum": 0},
    "namespace": {"type": ["string", "null"]},
    "metric_id": {"type": ["string", "null"]},
    "standard_number": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]}
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "document_id",
        "document_name",
        "document_version",
        "standard_number",
        "section",
        "clause",
        "page",
        "line_start",
        "line_end"
      ],
      "properties": {
        "chunk_id": {"type": "string"},
        "document_id": {"type": "string"},
        "document_name": {"type": "string"},
        "document_version": {"type": ["string", "null"]},
        "standard_number": {"type": ["string", "null"]},
        "section": {"type": ["string", "null"]},
        "clause": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
