{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-draft.schema.json",
  "title": "RuleDraft v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "workflow_id",
    "target_type",
    "target_metric_id",
    "user_intent",
    "status",
    "rule_spec",
    "evidence",
    "assumptions",
    "clarification_questions",
    "unsupported_reason",
    "provider",
    "context",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "draft_id": {
      "type": "string",
      "pattern": "^draft-[a-f0-9]{20}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^workflow-[a-f0-9]{20}$"
    },
    "target_type": {"enum": ["catalog_metric", "custom_rule"]},
    "target_metric_id": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 120}]
    },
    "user_intent": {"type": "string", "minLength": 1, "maxLength": 4000},
    "status": {
      "enum": [
        "collecting",
        "retrieving",
        "needs_clarification",
        "compiling",
        "draft",
        "validated",
        "dry_run_complete",
        "awaiting_approval",
        "approved",
        "executed",
        "rejected",
        "failed"
      ]
    },
    "rule_spec": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/ruleSpec"}]
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "assumptions": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "clarification_questions": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "unsupported_reason": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 2000}]
    },
    "provider": {"$ref": "#/$defs/provider"},
    "context": {"$ref": "#/$defs/context"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "allOf": [
    {
      "if": {"properties": {"target_type": {"const": "catalog_metric"}}},
      "then": {"properties": {"target_metric_id": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"target_type": {"const": "custom_rule"}}},
      "then": {"properties": {"target_metric_id": {"type": "null"}}}
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "source_id", "source_label", "location", "authoritative"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "type": {
          "enum": [
            "user_statement",
            "metric_definition",
            "standard_clause",
            "data_dictionary",
            "system_inference"
          ]
        },
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "source_id": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 300}]},
        "source_label": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 300}]},
        "location": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 500}]},
        "authoritative": {"type": "boolean"}
      }
    },
    "ruleSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_type",
        "rule_id",
        "name",
        "description",
        "fields",
        "parameters",
        "severity",
        "denominator_policy",
        "missing_value_policy",
        "evidence_ids",
        "resource_policy"
      ],
      "properties": {
        "rule_type": {
          "enum": ["primary_key", "required", "update_freshness", "allowed_values", "numeric_range"]
        },
        "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,79}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "parameters": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "maxProperties": 0},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["frequency", "max_age_days"],
              "properties": {
                "frequency": {"enum": ["daily", "weekly", "monthly", "quarterly", "yearly", "custom"]},
                "max_age_days": {"type": "integer", "minimum": 1, "maximum": 3660}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["allowed_values"],
              "properties": {
                "allowed_values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 500}, {"type": "number"}, {"type": "boolean"}]}
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "minimum": {"type": ["number", "null"]},
                "maximum": {"type": ["number", "null"]}
              }
            }
          ]
        },
        "severity": {"enum": ["info", "attention", "warning"]},
        "denominator_policy": {"enum": ["all_records", "non_missing"]},
        "missing_value_policy": {"enum": ["missing_is_violation", "missing_excluded"]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "resource_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_inspection_cells"],
          "properties": {"max_inspection_cells": {"type": "integer", "minimum": 1, "maximum": 2000000}}
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "mode", "prompt_version", "fallback_used", "fallback_reason", "request_id", "input_tokens", "output_tokens"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 100},
        "model": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 200}]},
        "mode": {"enum": ["template", "model"]},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "fallback_used": {"type": "boolean"},
        "fallback_reason": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 200}]},
        "request_id": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 200}]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_sha256", "input_sha256", "reference_date", "metric_catalog_version", "selected_metric_ids", "metric", "fields", "profile_summary"],
      "properties": {
        "report_sha256": {"oneOf": [{"type": "null"}, {"type": "string"}]},
        "input_sha256": {"oneOf": [{"type": "null"}, {"type": "string"}]},
        "reference_date": {"oneOf": [{"type": "null"}, {"type": "string"}]},
        "metric_catalog_version": {"oneOf": [{"type": "null"}, {"type": "string"}]},
        "selected_metric_ids": {"type": "array", "items": {"type": "string"}},
        "metric": {"type": "object"},
        "fields": {"type": "array", "items": {"type": "object"}},
        "profile_summary": {"type": "object"}
      }
    }
  }
}
