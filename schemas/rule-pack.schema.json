{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-pack.schema.json",
  "title": "RulePack v0.1（兼容 v0.7 规则来源）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_pack_id",
    "name",
    "version",
    "status",
    "base_report_sha256",
    "base_input_sha256",
    "reference_date",
    "source",
    "field_semantics",
    "rules",
    "metric_targets",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "rule_pack_id": {
      "type": "string",
      "pattern": "^rulepack-[0-9a-f]{20}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "base_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "base_input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reference_date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "field_semantics": {
      "$ref": "#/$defs/fieldSemantics"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "metric_targets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/metricTarget"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/approval"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "draft"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "approval": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "generator",
        "generated_at"
      ],
      "properties": {
        "type": {
          "enum": [
            "local_guided",
            "user_natural_language",
            "standard_retrieval"
          ]
        },
        "generator": {
          "enum": [
            "quality-rule-agent-v0.4",
            "quality-rule-agent-v0.7",
            "quality-rule-agent-v0.8",
            "quality-rule-agent-v0.9"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "local_guided"}}},
          "then": {"properties": {"generator": {"const": "quality-rule-agent-v0.4"}}}
        },
        {
          "if": {"properties": {"type": {"const": "user_natural_language"}}},
          "then": {"properties": {"generator": {"enum": ["quality-rule-agent-v0.7", "quality-rule-agent-v0.8"]}}}
        },
        {
          "if": {"properties": {"type": {"const": "standard_retrieval"}}},
          "then": {"properties": {"generator": {"const": "quality-rule-agent-v0.9"}}}
        }
      ]
    },
    "fieldName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "metricTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "target_metric_id"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "target_metric_id": {
          "type": "string",
          "pattern": "^db31_[0-9]{6}$"
        }
      }
    },
    "fieldSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key_fields",
        "required_fields",
        "update_time_field",
        "categorical_fields",
        "numeric_fields"
      ],
      "properties": {
        "primary_key_fields": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldName"
          }
        },
        "required_fields": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldName"
          }
        },
        "update_time_field": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fieldName"
            }
          ]
        },
        "categorical_fields": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldName"
          }
        },
        "numeric_fields": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldName"
          }
        },
        "formatted_fields": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldName"}
        },
        "length_checked_fields": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldName"}
        },
        "conditional_required_fields": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldName"}
        },
        "compared_fields": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldName"}
        }
      }
    },
    "jsonScalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "number",
          "minimum": -1e308,
          "maximum": 1e308
        },
        {
          "type": "boolean"
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "rule_id",
        "fields",
        "frequency",
        "max_age_days",
        "allowed_values",
        "minimum",
        "maximum"
      ],
      "properties": {
        "type": {
              "enum": [
                "primary_key",
                "required",
                "update_freshness",
                "allowed_values",
                "numeric_range",
                "regex_format",
                "string_length",
                "conditional_required",
                "field_comparison"
              ]
        },
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldName"
          }
        },
        "frequency": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_age_days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "allowed_values": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/jsonScalar"
          }
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1e308,
          "maximum": 1e308
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1e308,
          "maximum": 1e308
        },
        "regex_pattern": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "min_length": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000
        },
        "max_length": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000
        },
        "condition_field": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/fieldName"}]
        },
        "condition_values": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/jsonScalar"}
        },
        "comparison_operator": {
          "type": ["string", "null"],
          "enum": ["lt", "lte", "gt", "gte", "eq", "neq", null]
        },
        "comparison_type": {
          "type": ["string", "null"],
          "enum": ["auto", "numeric", "datetime", "text", null]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "primary_key",
                  "required"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "frequency": {
                "type": "null"
              },
              "max_age_days": {
                "type": "null"
              },
              "allowed_values": {
                "maxItems": 0
              },
              "minimum": {
                "type": "null"
              },
              "maximum": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "required",
                  "update_freshness",
                  "allowed_values",
                  "numeric_range"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "update_freshness"
              }
            }
          },
          "then": {
            "properties": {
              "frequency": {
                "enum": [
                  "daily",
                  "weekly",
                  "monthly",
                  "quarterly",
                  "yearly",
                  "custom"
                ]
              },
              "max_age_days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3660
              },
              "allowed_values": {
                "maxItems": 0
              },
              "minimum": {
                "type": "null"
              },
              "maximum": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "allowed_values"
              }
            }
          },
          "then": {
            "properties": {
              "frequency": {
                "type": "null"
              },
              "max_age_days": {
                "type": "null"
              },
              "allowed_values": {
                "minItems": 1
              },
              "minimum": {
                "type": "null"
              },
              "maximum": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "numeric_range"
              }
            }
          },
          "then": {
            "properties": {
              "frequency": {
                "type": "null"
              },
              "max_age_days": {
                "type": "null"
              },
              "allowed_values": {
                "maxItems": 0
              }
            },
            "anyOf": [
              {
                "properties": {
                  "minimum": {
                    "type": "number"
                  }
                }
              },
              {
                "properties": {
                  "maximum": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {"properties": {"type": {"const": "regex_format"}}},
          "then": {
            "properties": {
              "fields": {"maxItems": 1},
              "regex_pattern": {"type": "string", "minLength": 1},
              "frequency": {"type": "null"},
              "max_age_days": {"type": "null"},
              "allowed_values": {"maxItems": 0},
              "minimum": {"type": "null"},
              "maximum": {"type": "null"},
              "min_length": {"type": "null"},
              "max_length": {"type": "null"},
              "condition_field": {"type": "null"},
              "condition_values": {"maxItems": 0},
              "comparison_operator": {"type": "null"},
              "comparison_type": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "string_length"}}},
          "then": {
            "properties": {
              "fields": {"maxItems": 1},
              "frequency": {"type": "null"},
              "max_age_days": {"type": "null"},
              "allowed_values": {"maxItems": 0},
              "minimum": {"type": "null"},
              "maximum": {"type": "null"},
              "regex_pattern": {"type": "null"},
              "condition_field": {"type": "null"},
              "condition_values": {"maxItems": 0},
              "comparison_operator": {"type": "null"},
              "comparison_type": {"type": "null"}
            },
            "anyOf": [
              {"properties": {"min_length": {"type": "integer"}}},
              {"properties": {"max_length": {"type": "integer"}}}
            ]
          }
        },
        {
          "if": {"properties": {"type": {"const": "conditional_required"}}},
          "then": {
            "properties": {
              "fields": {"minItems": 2, "maxItems": 2},
              "frequency": {"type": "null"},
              "max_age_days": {"type": "null"},
              "allowed_values": {"maxItems": 0},
              "minimum": {"type": "null"},
              "maximum": {"type": "null"},
              "regex_pattern": {"type": "null"},
              "min_length": {"type": "null"},
              "max_length": {"type": "null"},
              "condition_field": {"type": "string"},
              "condition_values": {"minItems": 1},
              "comparison_operator": {"type": "null"},
              "comparison_type": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "field_comparison"}}},
          "then": {
            "properties": {
              "fields": {"minItems": 2, "maxItems": 2},
              "frequency": {"type": "null"},
              "max_age_days": {"type": "null"},
              "allowed_values": {"maxItems": 0},
              "minimum": {"type": "null"},
              "maximum": {"type": "null"},
              "regex_pattern": {"type": "null"},
              "min_length": {"type": "null"},
              "max_length": {"type": "null"},
              "condition_field": {"type": "null"},
              "condition_values": {"maxItems": 0},
              "comparison_operator": {"enum": ["lt", "lte", "gt", "gte", "eq", "neq"]},
              "comparison_type": {"enum": ["auto", "numeric", "datetime", "text"]}
            },
            "required": ["comparison_operator", "comparison_type"]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "source_id", "source_label", "location", "authoritative"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "type": {"enum": ["user_statement", "metric_definition", "standard_clause", "data_dictionary", "system_inference"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "source_id": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 300}]},
        "source_label": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 300}]},
        "location": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 500}]},
        "authoritative": {"type": "boolean"},
        "document_id": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 120}]},
        "document_name": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 300}]},
        "document_version": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 100}]},
        "section": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 300}]},
        "clause": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 120}]},
        "chunk_id": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 120}]},
        "page": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}
      },
      "allOf": [
        {
          "if": {"required": ["type"], "properties": {"type": {"enum": ["standard_clause", "data_dictionary"]}}},
          "then": {
            "required": ["document_name", "document_version", "chunk_id"],
            "anyOf": [{"required": ["section"]}, {"required": ["clause"]}]
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "approver",
        "approved_at",
        "draft_sha256",
        "base_report_sha256",
        "base_input_sha256",
        "reference_date",
        "statement",
        "identity_verified"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^approval-[0-9a-f]{20}$"
        },
        "approver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "draft_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "identity_verified": {
          "const": false
        }
      }
    }
  }
}
